   "id": "a8173afe",
   "metadata": {},
   "outputs": [],
   "source": [
    "date_01 = '1985-05-27'\n",
    "date_02 = '1995-05-27'\n",
    "date_03 = '2005-05-27'\n",
    "\n",
    "ds_date01 = sst_30y.sel(time=date_01)\n",
    "ds_date02 = sst_30y.sel(time=date_02)\n",
    "ds_date03 = sst_30y.sel(time=date_03)\n",
    "\n",
    "ds_clim_1980to2010 = sst_30y_mean.copy()\n",
    "\n",
    "anom_01 = ds_date01.sst - sst_30y_mean.sst\n",
    "anom_02 = ds_date02.sst - sst_30y_mean.sst\n",
    "anom_03 = ds_date03.sst - sst_30y_mean.sst"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "4bfe09db",
