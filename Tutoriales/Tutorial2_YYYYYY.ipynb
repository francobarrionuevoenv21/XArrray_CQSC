    }
   ],
   "source": [
    "# Definimos coordenadas\n",
    "lon_sel, lat_sel = -41, -25\n",
    "\n",
    "# Seleccionamos la ubicación y ploteamos\n",
    "sst_spatial_sel = sst_corr.sel(lon = lon_sel, lat = lat_sel, method = 'nearest')\n",
    "\n",
    "sst_spatial_sel.sst.plot(figsize=(15, 4))"
   ]
