   "source": [
    "ds_30y_month = sst_30y.groupby(\"time.month\").mean(dim=\"time\")\n",
    "sst_climM_MAM = ds_30y_month.sel(month=[3, 4, 5]).mean(dim='month').sst\n",
    "\n",
    "ds_30y_seas = sst_30y.groupby(\"time.season\").mean(\"time\")\n",
    "sst_climS_DJF = ds_30y_seas.sel(season=\"DJF\").sst"
   ]
  },
